{
  "settings": {
    "appFontFamily": "Hack Nerd Font",
    "appIcon": "classic",
    "autoRenameBranchFromWork": true,
    "branchPrefix": "git-username",
    "branchPrefixCustom": "",
    "browserSshWorkspaceRoutingEnabled": true,
    "defaultTaskSource": "gitlab",
    "disabledTuiAgents": [],
    "editorAutoSave": false,
    "editorAutoSaveDelayMs": 1000,
    "editorFontFamily": "",
    "editorMinimapEnabled": true,
    "editorWordWrap": true,
    "experimentalActivity": true,
    "experimentalAgentDashboardMode": "popout",
    "experimentalAgentDashboardPopout": true,
    "leftSidebarAppearanceMode": "default",
    "leftSidebarTintColor": "#18181b",
    "leftSidebarTintOpacity": 0.08,
    "markdownReviewToolsEnabled": true,
    "minimizeToTrayOnClose": false,
    "nestWorkspaces": true,
    "nestedWorkerMaxDepth": 3,
    "openInApplications": [
      {
        "id": "vscode",
        "label": "VS Code",
        "command": "code"
      },
      {
        "id": "cursor",
        "label": "Cursor",
        "command": "cursor"
      },
      {
        "id": "zed",
        "label": "Zed",
        "command": "zed"
      }
    ],
    "refreshLocalBaseRefOnWorktreeCreate": true,
    "richMarkdownSpellcheckEnabled": true,
    "tabAutoGenerateTitle": true,
    "terminalActivePaneOpacity": 1,
    "terminalAllowOsc52Clipboard": true,
    "terminalClipboardOnSelect": true,
    "terminalCursorBlink": true,
    "terminalCursorStyle": "block",
    "terminalDividerColorDark": "#3f3f46",
    "terminalDividerColorLight": "#d4d4d8",
    "terminalDividerThicknessPx": 3,
    "terminalFastScrollSensitivity": 5,
    "terminalFocusFollowsMouse": false,
    "terminalFontFamily": "Noto Sans Tagalog",
    "terminalFontSize": 12,
    "terminalFontWeight": 500,
    "terminalFontWeightBold": 700,
    "terminalGpuAcceleration": "auto",
    "terminalInactivePaneOpacity": 0.8,
    "terminalJISYenToBackslash": false,
    "terminalLigatures": "auto",
    "terminalLineHeight": 1,
    "terminalMacOptionAsAlt": "auto",
    "terminalMouseHideWhileTyping": false,
    "terminalPaneOpacityTransitionMs": 140,
    "terminalRightClickToPaste": false,
    "terminalScrollSensitivity": 1.15,
    "terminalScrollbackRows": 5000,
    "terminalShortcutPolicy": "orca-first",
    "terminalThemeDark": "Ghostty Default Style Dark",
    "terminalThemeLight": "Builtin Tango Light",
    "terminalTuiScrollSensitivity": 1,
    "terminalUseSeparateLightTheme": false,
    "theme": "dark",
    "uiLanguage": "system",
    "visibleTaskProviders": [
      "github",
      "gitlab",
      "linear",
      "jira"
    ],
    "windowBackgroundBlur": false,
    "worktreeVisibilityDefaults": {
      "external": "hide",
      "sourcePreferences": {
        "builtIn": {
          "claude": "show"
        }
      }
    }
  }
}

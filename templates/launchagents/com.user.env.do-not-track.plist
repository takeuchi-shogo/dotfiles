<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  env.do-not-track: GUI アプリ (Orca 等) とその子プロセス CLI に DO_NOT_TRACK=1 を届ける
  - shell の export は Dock/Spotlight 起動のアプリに届かないため launchd 側で setenv する
  - install: task launchd:do-not-track:install (反映は対象アプリの再起動後)
  - uninstall: task launchd:do-not-track:uninstall
  - shell 側は .config/zsh/core/exports.zsh で同じ値を export している
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.env.do-not-track</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/launchctl</string>
        <string>setenv</string>
        <string>DO_NOT_TRACK</string>
        <string>1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
